# Backend origin the marketing frontend calls for /api/marketing/* (waitlist,
# contact, demo, pricing). In production this is your app host.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# Product host — where signup/login/dashboard live (used for CTA links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# This marketing site's own public URL, used as metadataBase so absolute
# OG/twitter image URLs resolve correctly when pages are shared.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
